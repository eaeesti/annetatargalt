HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000

# Extra browser origins allowed to call the content API, beyond the
# production frontend and localhost:3000 (both always allowed). Comma-
# separated — e.g. for a Vercel preview URL. Leave unset unless you need it.
# CORS_ORIGINS=

# Trust X-Forwarded-For for the client's address. Turn this on ONLY when the
# proxy in front of this app overwrites that header with the real peer address
# rather than appending to it — otherwise a client can name any address it
# likes and pick its own rate-limit bucket. Left off, every request looks like
# it came from the proxy, and login lockout, rate limits and audit-log
# addresses all collapse into one shared bucket.
# SERVER_PROXY=true

# Extra origins that /donateExternal may send a donor back to after paying,
# beyond this org's own sites. Comma-separated, whole origins including the
# scheme (https://example.com). Anything not listed is rejected, so that this
# endpoint can't be used as an open redirect wearing our domain.
# EXTERNAL_RETURN_ORIGINS=

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Cloudinary
CLOUDINARY_NAME=tobemodified
CLOUDINARY_KEY=tobemodified
CLOUDINARY_SECRET=tobemodified

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=annetatargalt
DATABASE_USERNAME=tobemodified
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false

# Drizzle Database (separate from Strapi)
DRIZZLE_DATABASE_NAME=annetatargalt_donations

# Montonio
MONTONIO_URL=https://sandbox-payments.montonio.com
MONTONIO_PUBLIC=tobemodified
MONTONIO_PRIVATE=tobemodified
MONTONIO_RETURN_URL="http://localhost:1337/api"

# Email (Brevo via SMTP/Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tobemodified
SMTP_PASSWORD=tobemodified
BREVO_DEFAULT_SENDER_EMAIL=tobemodified
BREVO_DEFAULT_REPLY_TO=tobemodified