{
  "name": "annetatargalt-backend",
  "version": "2.0.0",
  "private": true,
  "description": "A Strapi application",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Andri Soone"
  },
  "scripts": {
    "generate-types": "node ../scripts/generate-strapi-types.mjs",
    "prebuild": "pnpm generate-types",
    "predev": "pnpm generate-types",
    "build": "rm -rf dist && strapi build",
    "dev": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "montonio-payouts-check": "dotenv -e .env -- node dist/src/scripts/montonio-payouts-check.js",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:push": "dotenv -e .env -- drizzle-kit push",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "dotenv -e .env.test -- vitest run repositories",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@fourlights/strapi-plugin-deep-populate": "^1.17.1",
    "@strapi/plugin-users-permissions": "5.58.0",
    "@strapi/provider-email-nodemailer": "5.58.0",
    "@strapi/provider-upload-cloudinary": "5.58.0",
    "@strapi/strapi": "5.58.0",
    "@strapi/utils": "5.58.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "koa2-ratelimit": "^1.1.3",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@strapi/typescript-utils": "5.58.0",
    "@tsconfig/node18": "^18.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^2.15.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x"
  },
  "packageManager": "pnpm@12.11.2",
  "strapi": {
    "uuid": "4e1433a7-7cec-47f0-9d05-3adba2a434bd"
  }
}
