{
  "name": "annetatargalt",
  "version": "2.0.0",
  "description": "Anneta Targalt donation platform",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Andri Soone"
  },
  "scripts": {
    "clear": "cd frontend && rm -rf .next && rm -rf cache",
    "develop": "pnpm run clear && concurrently \"cd frontend && pnpm develop\" \"cd backend && pnpm develop\" \"cd admin && pnpm dev\"",
    "install:frontend": "cd frontend && pnpm install",
    "install:backend": "cd backend && pnpm install",
    "install:admin": "cd admin && pnpm install",
    "install:all": "pnpm install && pnpm install:frontend && pnpm install:backend && pnpm install:admin",
    "generate-types": "node scripts/generate-strapi-types.mjs"
  },
  "dependencies": {
    "concurrently": "^7.6.0"
  },
  "packageManager": "pnpm@12.11.2"
}
