#!/bin/sh
# Before each commit: the formatter's check on the staged files, then lint,
# type check and unit tests for each app that has staged changes. It checks
# the files as they are on disk, which for a partly staged file includes the
# unstaged part. Skip it with `git commit --no-verify` when you must.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm isn't on this PATH, so the checks were skipped." >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 pnpm exec oxfmt --check --no-error-on-unmatched-pattern >/dev/null ||
  {
    echo "pre-commit: some staged files aren't formatted; run pnpm format." >&2
    exit 1
  }

for app in admin backend frontend; do
  if printf '%s\n' "$staged" | grep -q "^$app/"; then
    echo "pre-commit: checking $app"
    pnpm --dir "$app" --silent check
  fi
done
